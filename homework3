        print(f"Ты выбросил: {item}")
    else:
        print("Неверный индекс.")

def sort_inventory():
    inventory.sort()
    print("Инвентарь отсортирован.")

def reverse_inventory():
    inventory.reverse()
    print("Инвентарь перевёрнут.")

def copy_inventory():
    copied_inventory = inventory.copy()
    copied_inventory.append("Запасной предмет")
    print("Копия инвентаря:", copied_inventory)
    print("Оригинальный инвентарь:", inventory)

def generate_loot_list():
    loot = [random.choice(["Монета", "Зелье", "Меч", "Кристалл"]) for _ in range(5)]
    print("Список добычи:", loot)
    return loot

def change_item_property(item, property_name, value):
    if item not in item_properties:
        item_properties[item] = {}
    item_properties[item][property_name] = value
    print(f"Свойство предмета {item} изменено: {property_name} = {value}")

def use_potion():
    if "Зелье" in inventory:
        inventory.remove("Зелье")
        player["hp"] = min(100, player["hp"] + 30)
        print("Ты использовал зелье и восстановил 30 HP.")
    else:
        print("У тебя нет зелья.")

def show_help():
    print("\nКоманды:")
    print("W/A/S/D — движение")
    print("i — инвентарь")
    print("status — состояние игрока")
    print("drop — выбросить предмет по названию")
    print("pop — выбросить предмет по индексу")
    print("sort — сортировать инвентарь")
    print("reverse — перевернуть инвентарь")
    print("copy — показать копию инвентаря")
    print("loot — сгенерировать список добычи")
    print("property — изменить свойство предмета")
    print("potion — использовать зелье")
    print("help — помощь")
    print("q — выход")

def main():
    print("Добро пожаловать в лабиринт! Найди ключ и доберись до портала.")
    show_help()
    explore_room()
    while player["hp"] > 0:
        show_maze()
        command = input("\nТвоя команда: ").strip().lower()
        if command in ("w", "a", "s", "d"):
            if move_player(command) == "win":
                break
        elif command == "i":
            show_inventory()
        elif command == "status":
            show_status()
        elif command == "drop":
            item = input("Название предмета: ").strip()
            discard_item_by_name(item)
        elif command == "pop":
            index = int(input("Индекс предмета: "))
            discard_item_by_index(index)
        elif command == "sort":
            sort_inventory()
        elif command == "reverse":
            reverse_inventory()
        elif command == "copy":
            copy_inventory()
        elif command == "loot":
            generate_loot_list()
        elif command == "property":
            item = input("Название предмета: ").strip()
            property_name = input("Название свойства: ").strip()
            value = input("Новое значение: ").strip()
            change_item_property(item, property_name, value)
        elif command == "potion":
            use_potion()
        elif command == "help":
            show_help()
        elif command == "q":
            print("Игра завершена.")
            break
        else:
            print("Неизвестная команда. Введи help для списка команд.")

if __name__ == "__main__":
    main()
